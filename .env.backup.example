# Lumens — cópia do backup fora da VM e alerta de falha (SCRUM-309)
#
# Copie para `.env.backup` na VM (`chmod 600`) e preencha. Só os scripts de backup o leem
# (enviar-backup.sh e alertar-falha.sh); nenhum contêiner o recebe. Passo a passo, inclusive a
# criação do bucket e das chaves no Backblaze: docs/operacao/backup.md


# ---------------------------------------------------------------------------
# Destino: bucket privado no Backblaze B2, pela API S3 dele
# ---------------------------------------------------------------------------
# O endpoint e a região aparecem na página do bucket ("Endpoint": s3.<região>.backblazeb2.com).
BACKUP_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKUP_S3_REGIAO=us-east-005
BACKUP_S3_BUCKET=lumens-backup
# A Application Key da VM: restrita a este bucket e Write Only. Ela não lê nem apaga as cópias. A
# chave que lê fica fora da VM, no gerenciador de senhas.
BACKUP_S3_CHAVE_ID=
BACKUP_S3_CHAVE=


# ---------------------------------------------------------------------------
# Cifra (age)
# ---------------------------------------------------------------------------
# Chave(s) PÚBLICA(S) `age1...`, separadas por espaço. A privada correspondente NUNCA vem para a
# VM: fica no gerenciador de senhas da equipe. Sem ela, nenhuma cópia de fora se restaura.
BACKUP_AGE_DESTINATARIOS=


# ---------------------------------------------------------------------------
# Alerta de falha (pelo SMTP do EMAIL_* do .env.producao)
# ---------------------------------------------------------------------------
# Um ou mais e-mails, separados por vírgula. Vazio (ou sem este arquivo), o aviso vai para a conta
# do EMAIL_USUARIO.
BACKUP_ALERTA_PARA=
