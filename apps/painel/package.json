{
  "name": "@lumens/painel",
  "version": "0.0.0",
  "private": true,
  "description": "Painel de curadoria do Lumens (Next.js, parte 5).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cobertura": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.*' --coverage.exclude='**/*.d.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@lumens/db": "workspace:*",
    "@lumens/dominio": "workspace:*",
    "@lumens/marca": "workspace:*",
    "next": "^16.4.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1"
  }
}
