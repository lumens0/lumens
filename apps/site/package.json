{
  "name": "@lumens/site",
  "version": "0.0.0",
  "private": true,
  "description": "Site público do Lumens (Next.js, parte 4).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "cobertura": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.*' --coverage.exclude='**/*.d.ts' --exclude 'e2e/**'",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lumens/contratos": "workspace:*",
    "@lumens/marca": "workspace:*",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1"
  }
}
