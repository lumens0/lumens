{
  "name": "@lumens/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Back-end Node.js: bot (webhook da Meta), agendador e API.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/main.ts --dev",
    "env:check": "tsx --env-file-if-exists=../../.env src/main.ts --dev --so-validar",
    "start": "tsx src/main.ts",
    "sim": "tsx --env-file-if-exists=../../.env scripts/sim.ts",
    "fixtures": "tsx scripts/gerar-fixtures.ts",
    "modelos": "tsx --env-file-if-exists=../../.env scripts/modelos.ts",
    "curador": "tsx --env-file-if-exists=../../.env scripts/curador.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.database ../../node_modules/vitest/vitest.mjs run --passWithNoTests --hookTimeout=30000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@lumens/contratos": "workspace:*",
    "@lumens/db": "workspace:*",
    "@lumens/dominio": "workspace:*",
    "fastify": "^5.12.7",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
