# HTTPS da homologação (SCRUM-93). O Caddy pede e renova o certificado do Let's Encrypt
# sozinho, desde que o DOMINIO aponte para o IP desta instância e as portas 80 e 443
# estejam abertas no security group — a validação usa a 80.
#
# A AWS bloqueia emissão para *.amazonaws.com, então o DNS público da instância não serve:
# precisa de um domínio de verdade (o da UFAL, ou um subdomínio gratuito).

# Cabeçalhos de segurança da API e do painel (SCRUM-303). Nenhuma das duas é feita para abrir
# dentro de outra página: frame-ancestors e X-Frame-Options fecham o clickjacking (o painel tem
# botões de aprovar e recusar). O HSTS vale para os subdomínios, que são todos HTTPS pelo Caddy.
# `-Server` e `-X-Powered-By` tiram a versão do software da resposta.
(cabecalhos_de_seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

{$DOMINIO} {
	encode zstd gzip
	import cabecalhos_de_seguranca

	# O webhook da Evolution (SCRUM-275) chega pela rede interna do compose, nunca pela
	# internet. O back-end já exige o segredo; fechar aqui tira a rota da superfície pública.
	respond /webhook/evolution* 404

	# O webhook da Meta chega aqui. O back-end confere a assinatura do corpo, então o
	# proxy não pode reescrever o payload — só repassa.
	reverse_proxy backend:3000

	log {
		# O handshake da Meta manda o META_VERIFY_TOKEN na query (`hub.verify_token`).
		# O back-end já corta a query do próprio log; sem isto aqui, o log do Caddy
		# seria o único lugar do ambiente que ainda guardaria o token em texto.
		format filter {
			wrap console
			fields {
				request>uri query {
					replace hub.verify_token REDACTED
				}
			}
		}
	}
}

# Painel de curadoria. Com DuckDNS, `painel.<nome>.duckdns.org` já resolve para o mesmo IP;
# com outro DNS, crie o registro antes do deploy, senão o certificado deste nome não sai.
#
# Sem bloco `log` de propósito: o link de acesso chega como
# /api/auth/callback/nodemailer?token=...&email=..., e um access log guardaria o token e o
# e-mail da curadora em texto. O Caddy não registra acessos sem a diretiva.
painel.{$DOMINIO} {
	encode zstd gzip
	import cabecalhos_de_seguranca
	reverse_proxy painel:3002
}
