{
  "name": "@lumens/marca",
  "version": "0.0.0",
  "private": true,
  "description": "Identidade visual do Lumens (cores, raio, ritmo e cores de status) usada pelo site e pelo painel.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fluxo": "./src/fluxo.tsx",
    "./fluxo.css": "./src/fluxo.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "cobertura": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.*' --coverage.exclude='**/*.d.ts'"
  },
  "dependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react-dom": "^19.3.1"
  }
}
