# Lumens — credenciais administrativas do banco em homologação (SCRUM-93)
#
# Copie para `.env.producao.admin` na instância e preencha. Este arquivo é o equivalente
# do `.env.database` local, e vale a mesma regra: **o back-end NÃO o carrega**.
#
# Só os serviços `postgres` e `migracao` do docker-compose.prod.yml o recebem. O serviço
# `backend` enxerga apenas o `.env.producao`, com os logins restritos.
#
# O porquê: se o processo que atende a internet tivesse `DATABASE_URL_MIGRACAO`, um
# comprometimento dele daria acesso de owner ao banco — apagando trigger, reescrevendo a
# linha do tempo de eventos e contornando os privilégios de `lumens_app`. A separação está
# documentada em packages/db/README.md e é exercida pelo teste de isolamento em
# apps/backend/src/config/scripts.test.ts.

# Owner do cluster. Cria objetos e aplica migrações; o back-end nunca usa.
POSTGRES_USER=lumens
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_DB=lumens

# O host é `postgres`, o nome do serviço no compose — não localhost.
DATABASE_URL_MIGRACAO=postgresql://lumens:troque-por-uma-senha-longa-e-aleatoria@postgres:5432/lumens

# Senhas dos dois logins restritos que o `pnpm db:provision` cria. Repita cada uma na URL
# correspondente do `.env.producao` — lá elas aparecem dentro de DATABASE_URL e
# DATABASE_URL_LEITURA.
POSTGRES_APP_PASSWORD=troque-por-outra-senha-longa
POSTGRES_SITE_PASSWORD=troque-por-mais-outra-senha-longa
