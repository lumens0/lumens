# Lumens — ambiente da homologação na AWS (SCRUM-93)
#
# Este arquivo é um modelo. O `.env.producao` de verdade vive SÓ na instância EC2, nunca
# no repositório: `cp .env.producao.example .env.producao` lá no servidor e preencha.
#
# As credenciais administrativas do banco NÃO ficam aqui: elas vivem no
# `.env.producao.admin`, que só os serviços `postgres` e `migracao` recebem. É a mesma
# separação do `.env` e `.env.database` locais — o processo que atende a internet nunca
# enxerga o login de owner do banco.
#
# REGRA: nenhuma chave daqui pode ser igual à do seu `.env` local. Homologação atende a
# internet e o número da Meta; a máquina do dev, não.


# ---------------------------------------------------------------------------
# Domínio público
# ---------------------------------------------------------------------------
# Domínio que aponta para o IP desta instância. O Caddy emite o certificado para ele,
# e é a URL que vai no webhook da Meta. Sem subdomínio da UFAL, use um gratuito.
# NÃO funciona com o DNS público da AWS: o Let's Encrypt recusa *.amazonaws.com.
DOMINIO=lumens.exemplo.org


# ---------------------------------------------------------------------------
# Servidor do back-end
# ---------------------------------------------------------------------------
# O Caddy fala com o contêiner nesta porta. Mantenha 3000: é o que está no Caddyfile,
# no EXPOSE do Dockerfile e no healthcheck do compose.
PORT=3000
LOG_LEVEL=info
# Sem barra final. É o site na Vercel que consome a API de leitura.
CORS_ORIGENS=https://lumens-ufal.vercel.app


# ---------------------------------------------------------------------------
# Conexões da aplicação
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://lumens_app:troque-por-outra-senha-longa@postgres:5432/lumens
DATABASE_URL_LEITURA=postgresql://lumens_site:troque-por-mais-outra-senha-longa@postgres:5432/lumens


# ---------------------------------------------------------------------------
# Chaves de criptografia (T17 / SCRUM-90)
# ---------------------------------------------------------------------------
# DUAS chaves DIFERENTES, e diferentes também das locais. Gere cada uma na instância:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CIFRA=
CHAVE_HMAC=


# ---------------------------------------------------------------------------
# WhatsApp / Meta
# ---------------------------------------------------------------------------
META_TOKEN=
META_APP_SECRET=
# O mesmo valor que você digita no painel da Meta ao cadastrar o webhook
# https://<DOMINIO>/webhook
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
# Só a máquina de quem submete os modelos precisa deste. No servidor fica vazio.
META_WABA_ID=


# ---------------------------------------------------------------------------
# Canal do bot e Telegram
# ---------------------------------------------------------------------------
# `whatsapp` (padrão, vazio) ou `telegram`: um só por implantação. Com `telegram`, as META_* acima
# são ignoradas e o webhook do Telegram é registrado uma vez com:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<DOMINIO>/telegram/webhook&secret_token=<SEGREDO>
CANAL_BOT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODO=webhook
# O mesmo <SEGREDO> do setWebhook. Gere na instância:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Painel de curadoria (https://painel.<DOMINIO>)
# ---------------------------------------------------------------------------
# Assina a sessão do Auth.js. Só o painel lê. Gere na instância:
#   openssl rand -base64 32
# O painel usa também DATABASE_URL, CHAVE_HMAC e EMAIL_* deste arquivo. Quem pode entrar:
#   docker compose -f docker-compose.prod.yml --env-file .env.producao run --rm -T backend \
#     pnpm --filter @lumens/backend curador <email> "<nome>"
AUTH_SECRET=


# ---------------------------------------------------------------------------
# E-mail (código de verificação do estudante e link de acesso do painel)
# ---------------------------------------------------------------------------
# SMTP do Google da conta @ic.ufal.br, com senha de app; USUARIO e REMETENTE são o mesmo
# endereço. Pela Brevo, o Gmail marca o e-mail como possível falsificação (SCRUM-139).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE=


# ---------------------------------------------------------------------------
# AWS / fotos
# ---------------------------------------------------------------------------
# Sem chave de acesso aqui: a instância recebe um papel IAM e o SDK a pega sozinho.
# Chave fixa em arquivo no servidor é o que mais vaza.
AWS_REGION=us-east-1
S3_BUCKET_FOTOS=
S3_ENDPOINT=
