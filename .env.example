# Lumens — variáveis de ambiente (SCRUM-75)
#
# Copie para `.env` e preencha:  cp .env.example .env
# O `.env` é ignorado pelo git e NUNCA deve ser commitado. Este arquivo aqui só tem
# valores de desenvolvimento local e marcadores — nenhum segredo real.
#
# Em produção, os segredos vivem no cofre da hospedagem e no CI, não em arquivo
# (Roteiro da Parte 1, seção 6 "Segredos").


# ---------------------------------------------------------------------------
# Servidor do back-end
# ---------------------------------------------------------------------------
# Porta do servidor HTTP (webhook da Meta). Vazia = 3001.
PORT=3001
# Nível de log do pino: fatal, error, warn, info, debug, trace ou silent. Vazio = info.
LOG_LEVEL=info
# Origens do site que podem chamar a API de leitura pelo navegador (CORS), separadas
# por vírgula, sem barra final. Vazia = https://lumens-ufal.vercel.app (produção).
CORS_ORIGENS=http://localhost:3000


# ---------------------------------------------------------------------------
# Site público (apps/site, SCRUM-26)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* vão para o bundle do navegador e são fixadas no build: nada secreto aqui.
# Número do bot no WhatsApp, com DDI. Só os dígitos contam (`+55 82 ...` vira `5582...`).
# Obrigatória no `next build`: sem ela o build falha (SCRUM-43). No `next dev`, vazia esconde os
# botões "Apoiar", "Relatar um problema" e "Vou ajudar".
NEXT_PUBLIC_WHATSAPP_BOT=
# `1` mostra o botão "Apoiar" nas pautas. Desligado até o bot interpretar `apoiar <slug>` (2.8 / SCRUM-103).
NEXT_PUBLIC_FLAG_APOIAR=
# Endereço da API de leitura (apps/backend), sem barra final. Lida só no servidor do Next.js
# (sem NEXT_PUBLIC, não vai para o navegador). Obrigatória para a página da pauta (SCRUM-27).
LUMENS_API_URL=http://localhost:3001
# Origem pública do site, COM o esquema (`https://...`), sem barra final. Base das URLs absolutas
# dos metadados (`og:image` da prévia do link, SCRUM-55). Lida só no servidor. Vazia ou inválida =
# `https://$VERCEL_URL` (deploy atual na Vercel) ou, fora dela, https://lumens-ufal.vercel.app.
LUMENS_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Conexões da aplicação
# ---------------------------------------------------------------------------
# O backend usa somente o login restrito. Credenciais do owner/migrador ficam no
# arquivo separado `.env.database`, que os scripts do backend não carregam.
DATABASE_URL=postgresql://lumens_app:lumens_app_local@localhost:5432/lumens

# Usuário SÓ DE LEITURA, usado pelo site. Ele enxerga apenas as views públicas,
# que já vêm sem identidade — é assim que a RNF01 é garantida mesmo se o código
# do site tiver um bug. `pnpm db:provision` cria o login `lumens_site` com a senha
# de POSTGRES_SITE_PASSWORD (em `.env.database`); as views e os grants vêm do
# `pnpm db:migrate` (T14 / SCRUM-87).
DATABASE_URL_LEITURA=postgresql://lumens_site:lumens_site_local@localhost:5432/lumens


# ---------------------------------------------------------------------------
# Chaves de criptografia (T17 / SCRUM-90)
# ---------------------------------------------------------------------------
# ATENÇÃO: são DUAS chaves DIFERENTES. Não repita o mesmo valor nas duas.
#   - CHAVE_CIFRA cifra telefone e e-mail (AES-256-GCM).
#   - CHAVE_HMAC gera o HMAC-SHA256 que permite BUSCAR pelo telefone sem decifrar
#     a base inteira.
# Usar o mesmo valor nas duas elimina a separação entre cifrar e buscar, e nada
# no sistema avisa — por isso a validação do back-end recusa chaves iguais.
#
# Gerar cada uma (32 bytes em base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

CHAVE_CIFRA=cole-aqui-32-bytes-em-base64
CHAVE_HMAC=cole-aqui-OUTROS-32-bytes-em-base64


# ---------------------------------------------------------------------------
# WhatsApp / Meta (parte 2)
# ---------------------------------------------------------------------------
# Do app da Meta. Em desenvolvimento, use o número de teste (RNF06).

META_TOKEN=cole-aqui-o-token-de-acesso
# Assina o corpo de cada POST do webhook (header X-Hub-Signature-256). O simulador
# (`pnpm --filter @lumens/backend sim`) assina com este mesmo valor.
META_APP_SECRET=cole-aqui-o-app-secret
# Você inventa este valor e repete no painel da Meta ao configurar o webhook.
META_VERIFY_TOKEN=escolha-uma-frase-qualquer
META_PHONE_NUMBER_ID=cole-aqui-o-id-do-numero
# Pessoas distintas que o bot pode alcançar por 24h com mensagem modelo (RNF06). Vazio = 250,
# o limite de um portfólio novo. Suba quando o WhatsApp Manager mostrar um nível maior.
META_LIMITE_PESSOAS=
# Só para submeter as mensagens modelo (`pnpm --filter @lumens/backend modelos`).
# O servidor não lê: fica vazio fora da máquina de quem submete.
META_WABA_ID=


# ---------------------------------------------------------------------------
# Painel de curadoria (login por link no e-mail, SCRUM-164)
# ---------------------------------------------------------------------------
# O painel usa DATABASE_URL, CHAVE_HMAC e as variáveis EMAIL_* daqui. Esta é só
# dele: assina a sessão do Auth.js. Gere com: openssl rand -base64 32
# Na Vercel, cadastre as mesmas variáveis no projeto do painel.

AUTH_SECRET=cole-aqui-32-bytes-em-base64


# ---------------------------------------------------------------------------
# E-mail (código de verificação do estudante e link do painel)
# ---------------------------------------------------------------------------
# Serviço SMTP em plano gratuito (RNF12 — custo).
# Use o SMTP do Google da própria conta @ic.ufal.br, com uma senha de app
# (myaccount.google.com/apppasswords). Um SMTP de terceiros (ex.: Brevo) com remetente
# @ic.ufal.br cai no alerta de falsificação do Gmail: o SPF da UFAL só autoriza o Google
# (SCRUM-139, docs/sdd/SCRUM-99-verificacao-email/TESTS.md).

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USUARIO=seu-usuario@ic.ufal.br
EMAIL_SENHA=cole-aqui-a-senha-de-app
EMAIL_REMETENTE=seu-usuario@ic.ufal.br


# ---------------------------------------------------------------------------
# AWS / fotos (T20 — SCRUM-93)
# ---------------------------------------------------------------------------
# Em produção as credenciais vêm do papel IAM, não daqui.

AWS_REGION=us-east-1
S3_BUCKET_FOTOS=lumens-fotos

# Só para uso local, apontando para um emulador de S3. Deixe vazio para usar a AWS
# de verdade. O emulador ainda não faz parte do docker-compose (entra junto com a
# parte de fotos).
S3_ENDPOINT=
